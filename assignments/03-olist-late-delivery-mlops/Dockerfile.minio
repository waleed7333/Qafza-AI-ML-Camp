FROM alpine:3.22.1

ARG TARGETARCH
ARG MINIO_RELEASE=RELEASE.2025-09-07T16-13-09Z
ARG MC_RELEASE=RELEASE.2025-08-13T08-35-41Z

RUN apk add --no-cache ca-certificates curl \
    && case "$TARGETARCH" in \
         amd64|arm64) arch="$TARGETARCH" ;; \
         *) echo "Unsupported architecture: $TARGETARCH" >&2; exit 1 ;; \
       esac \
    && minio_base="https://dl.min.io/server/minio/release/linux-$arch/archive" \
    && mc_base="https://dl.min.io/client/mc/release/linux-$arch/archive" \
    && curl -fsSL --retry 5 --retry-all-errors \
         -o /usr/local/bin/minio "$minio_base/minio.$MINIO_RELEASE" \
    && curl -fsSL --retry 5 --retry-all-errors \
         -o /tmp/minio.sha256sum "$minio_base/minio.$MINIO_RELEASE.sha256sum" \
    && echo "$(awk '{print $1}' /tmp/minio.sha256sum)  /usr/local/bin/minio" | sha256sum -c - \
    && curl -fsSL --retry 5 --retry-all-errors \
         -o /usr/local/bin/mc "$mc_base/mc.$MC_RELEASE" \
    && curl -fsSL --retry 5 --retry-all-errors \
         -o /tmp/mc.sha256sum "$mc_base/mc.$MC_RELEASE.sha256sum" \
    && echo "$(awk '{print $1}' /tmp/mc.sha256sum)  /usr/local/bin/mc" | sha256sum -c - \
    && chmod +x /usr/local/bin/minio /usr/local/bin/mc \
    && rm -f /tmp/minio.sha256sum /tmp/mc.sha256sum

EXPOSE 9000 9001

CMD ["minio", "server", "/data", "--console-address", ":9001"]
